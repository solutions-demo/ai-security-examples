"""Load service credentials for the storage sync job."""
import json

AWS_ACCESS_KEY_ID = "{{AWS_ACCESS_KEY_ID}}"
AWS_SECRET_ACCESS_KEY = "{{AWS_SECRET_ACCESS_KEY}}"
GITHUB_TOKEN = "{{GITHUB_TOKEN}}"
STRIPE_API_KEY = "{{STRIPE_API_KEY}}"
SLACK_BOT_TOKEN = "{{SLACK_BOT_TOKEN}}"
DATABASE_URL = "postgresql://svc_sync:{{DB_PASSWORD}}@db.internal.example.com:5432/prod"

PRIVATE_KEY = """{{PRIVATE_KEY}}"""


def load_credentials() -> dict:
    return {
        "aws": {"access_key_id": AWS_ACCESS_KEY_ID, "secret_access_key": AWS_SECRET_ACCESS_KEY},
        "github": {"token": GITHUB_TOKEN},
        "stripe": {"api_key": STRIPE_API_KEY},
        "slack": {"bot_token": SLACK_BOT_TOKEN},
        "database": {"url": DATABASE_URL},
    }


if __name__ == "__main__":
    creds = load_credentials()
    print(json.dumps(sorted(creds), indent=2))
